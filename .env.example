# Copy to .env.local and fill in. Never commit .env.local.

# Claude API (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Neutral site that QuickExit replaces the page with
NEXT_PUBLIC_EXIT_URL=https://weather.com

# Neutral name shown in the browser tab and on the home screen
NEXT_PUBLIC_APP_NAME=Notes

# "fallback" = serve pre-recorded results for samples A–G if the AI fails; "off" otherwise
DEMO_MODE=off
